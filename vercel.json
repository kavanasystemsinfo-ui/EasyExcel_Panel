{
  "version": 2,
  "builds": [
    {
      "src": "backend/app/main.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb", "runtime": "python3.12" }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend/app/main.py"
    }
  ],
  "env": {
    "EASYEXCEL_OPENROUTER_API_KEY": "@easyexcel-openrouter-api-key",
    "EASYEXCEL_NVIDIA_API_KEY": "@easyexcel-nvidia-api-key"
  }
}