# URL publica de la API (para CORS; en produccion el proxy /api sirve todo
# desde el mismo origen y no hace falta abrir CORS)
EASYEXCEL_CORS_ORIGINS=["http://localhost:5173"]

# --- Copiloto IA (modelos gratuitos; al menos una clave es obligatoria) ---
# Cadena OpenRouter principal (por defecto, configurable)
EASYEXCEL_OPENROUTER_API_KEY=
EASYEXCEL_OPENROUTER_MODELS=google/gemma-4-31b-it:free,cohere/north-mini-code:free
# Respaldo NVIDIA cuando OpenRouter agota la cuota diaria
EASYEXCEL_NVIDIA_API_KEY=
EASYEXCEL_NVIDIA_MODELS=google/gemma-4-31b-it
# Protecciones: 20 consultas / dia por IP (ADR-0006) y cache de preguntas repetidas
EASYEXCEL_COPILOTO_RATE_LIMIT=20
EASYEXCEL_COPILOTO_RATE_WINDOW_S=86400
# 1500 porque north-mini entra en razonamiento: con 600 el resumen salia vacio
EASYEXCEL_COPILOTO_MAX_TOKENS=1500
EASYEXCEL_COPILOTO_TIMEOUT_S=90

# --- Almacenamiento de subidas ---
# En produccion (Render) apunta al disco persistente; si se omite se usa
# backend/data/uploads. Las subidas caducan a las 2 h (ADR-0004).
EASYEXCEL_UPLOAD_DIR=
EASYEXCEL_UPLOAD_TTL_HOURS=2
